{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "standards.schema.json",
  "title": "AI Agile Standards",
  "description": "Schema for standards/*.json files loaded by the coder and pr-reviewer agents. Each file is either a StandardsFile (array of enforceable rules) or an AdrsFile (registry of approved exceptions).",
  "oneOf": [
    { "$ref": "#/definitions/StandardsFile" },
    { "$ref": "#/definitions/AdrsFile" }
  ],
  "definitions": {
    "Standard": {
      "type": "object",
      "required": ["id", "title", "severity", "description", "rationale", "acceptance_criteria", "anti_patterns", "applies_to"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^STD-[A-Z]+-\\d{3}$",
          "description": "Unique identifier, e.g. STD-ARCH-001."
        },
        "title": {
          "type": "string",
          "maxLength": 80,
          "description": "Short imperative title (≤10 words)."
        },
        "severity": {
          "type": "string",
          "enum": ["High", "Medium", "Low"],
          "description": "High = correctness/security; Medium = maintainability; Low = style."
        },
        "description": {
          "type": "string",
          "description": "One or two sentences. States precisely what is required or forbidden."
        },
        "rationale": {
          "type": "string",
          "description": "One or two sentences explaining WHY. May cite source file/section."
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Concrete, diff-checkable statements. Each starts with a subject and verb."
        },
        "anti_patterns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Specific examples of what violates this rule."
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["coder", "pr-reviewer", "issue-classifier", "prd-writer"]
          },
          "description": "Which pipeline agents enforce this standard."
        },
        "source": {
          "type": "string",
          "description": "Optional: migration provenance, e.g. 'Migrated from CLAUDE.md — §Principles'."
        }
      }
    },
    "StandardsFile": {
      "type": "object",
      "required": ["version", "category", "standards"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "version": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "standards": {
          "type": "array",
          "items": { "$ref": "#/definitions/Standard" }
        }
      }
    },
    "AdrsFile": {
      "type": "object",
      "required": ["version", "adrs"],
      "additionalProperties": false,
      "properties": {
        "$schema": { "type": "string" },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "adrs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "authorises_exception_to", "rationale"],
            "properties": {
              "id": { "type": "string", "pattern": "^ADR-\\d{3}$" },
              "title": { "type": "string" },
              "authorises_exception_to": {
                "type": "array",
                "items": { "type": "string" }
              },
              "rationale": { "type": "string" },
              "approved_by": { "type": "string" },
              "approved_at": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
