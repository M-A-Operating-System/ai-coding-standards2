{
  "schema_version": "0.2.0",
  "description": "Starter deterministic classification rules; refine against the selected CodeQL/CPG fact shape.",
  "rules": [
    {
      "id": "PY_FASTAPI_ROUTE_HANDLER",
      "description": "Classify FastAPI route functions as request handlers.",
      "match": {
        "language": "python",
        "imports_any": [
          "fastapi"
        ],
        "decorator_regex": ".*\\.(get|post|put|patch|delete|options|head)$"
      },
      "assign": {
        "code": [
          "code/api/handler/request-handler"
        ]
      }
    },
    {
      "id": "PY_REPOSITORY_CLASS",
      "description": "Classify repository implementations from naming plus persistence evidence.",
      "match": {
        "language": "python",
        "class_regex": ".*Repository$",
        "calls_any_prefix": [
          "sqlalchemy.",
          "django.db.",
          "pymongo."
        ]
      },
      "assign": {
        "code": [
          "code/persistence/repository/repository-implementation"
        ],
        "patterns": [
          "patterns/persistence/data-access/repository"
        ]
      }
    },
    {
      "id": "PY_TEST_FUNCTION",
      "description": "Classify conventional Python test functions.",
      "match": {
        "language": "python",
        "file_regex": "(^|/)test_.*\\.py$|(^|/)tests?/",
        "function_regex": "^test_"
      },
      "assign": {
        "code": [
          "code/testing/test/unit-test"
        ]
      }
    },
    {
      "id": "MESSAGE_CONSUMER",
      "description": "Classify functions/methods that consume from known messaging clients.",
      "match": {
        "calls_any_prefix": [
          "kafka.",
          "confluent_kafka.",
          "pika.",
          "boto3.sqs.",
          "azure.servicebus."
        ]
      },
      "assign": {
        "code": [
          "code/messaging/consumer/message-consumer"
        ]
      }
    }
  ]
}
