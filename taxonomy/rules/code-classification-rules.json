{
  "schema_version": "0.3.1",
  "definition": "Starter deterministic rules mapping static-analysis facts into taxonomy IDs.",
  "rules": [
    {
      "id": "PY_FASTAPI_ROUTE_HANDLER",
      "description": "FastAPI-decorated route functions are request handlers.",
      "match": {
        "language": "python",
        "imports_any": [
          "fastapi"
        ],
        "decorator_regex": ".*\\.(get|post|put|patch|delete|options|head)$"
      },
      "assign": {
        "code": [
          "code/api/handler/request-handler"
        ]
      }
    },
    {
      "id": "PY_REPOSITORY_IMPLEMENTATION",
      "description": "Repository naming plus persistence API evidence identifies repository implementations.",
      "match": {
        "language": "python",
        "class_regex": ".*Repository$",
        "calls_any_prefix": [
          "sqlalchemy.",
          "django.db.",
          "pymongo."
        ]
      },
      "assign": {
        "code": [
          "code/persistence/repository/repository-implementation"
        ],
        "patterns": [
          "patterns/persistence/data-access/repository"
        ]
      }
    },
    {
      "id": "PY_TEST_FUNCTION",
      "description": "Conventional Python test functions are unit-test candidates.",
      "match": {
        "language": "python",
        "file_regex": "(^|/)test_.*\\.py$|(^|/)tests?/",
        "function_regex": "^test_"
      },
      "assign": {
        "code": [
          "code/testing/test/unit-test"
        ]
      }
    },
    {
      "id": "MESSAGE_CONSUMER",
      "description": "Known message-consumption APIs identify message consumer roles.",
      "match": {
        "calls_any_prefix": [
          "kafka.",
          "confluent_kafka.",
          "pika.",
          "boto3.sqs.",
          "azure.servicebus."
        ]
      },
      "assign": {
        "code": [
          "code/messaging/consumer/message-consumer"
        ]
      }
    }
  ]
}
