{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "semantic-analysis-boundary.schema.json",
  "title": "Semantic Analysis Boundary",
  "type": "object",
  "required": [
    "schema_version",
    "external_semantic_sources",
    "taxonomy_owns"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "external_semantic_sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "owns",
          "role"
        ],
        "properties": {
          "owns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "taxonomy_owns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "additionalProperties": true
}
