{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domain-taxonomy.schema.json",
  "title": "Domain Taxonomy",
  "type": "object",
  "required": [
    "schema_version",
    "domain",
    "inheritance",
    "families"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "domain": {
      "description": "The partition this file carries. A domain is a field with a controlled value set, not a level and not a record with identity: nothing specialises into a family, a family belongs to a domain.",
      "enum": [
        "architecture",
        "patterns",
        "code",
        "concepts"
      ]
    },
    "description": {
      "type": "string"
    },
    "inheritance": {
      "type": "object"
    },
    "families": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "node.schema.json"
      }
    }
  },
  "additionalProperties": true
}
