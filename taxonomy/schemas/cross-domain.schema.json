{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cross-domain.schema.json",
  "title": "Cross-Domain Relationships",
  "type": "object",
  "required": [
    "schema_version",
    "relationships"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "type",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
