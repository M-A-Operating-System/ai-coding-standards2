{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "classification-rules-file.schema.json",
  "title": "Deterministic Code Classification Rule Set",
  "type": "object",
  "required": [
    "schema_version",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "classification-rule.schema.json"
      }
    }
  },
  "additionalProperties": true
}
