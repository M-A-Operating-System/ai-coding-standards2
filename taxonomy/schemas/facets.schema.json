{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facets.schema.json",
  "title": "Facet Registry",
  "type": "object",
  "required": [
    "schema_version",
    "facets"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "facets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "description",
          "multi_valued",
          "values"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "multi_valued": {
            "type": "boolean"
          },
          "values": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "domains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
