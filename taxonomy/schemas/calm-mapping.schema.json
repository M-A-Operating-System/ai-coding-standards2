{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calm-mapping.schema.json",
  "title": "CALM to Canonical Mapping",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "mappings"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "mappings": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    }
  },
  "additionalProperties": true
}
