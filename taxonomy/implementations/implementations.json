      ],
      "related_code": [
        "code/api/handler/request-handler"
      ]
    },
    "spring-boot": {
      "name": "Spring Boot",
      "kind": "framework",
      "implements": [
        "architecture/compute/service/api-service"
      ]
    },
    "aspnet-core": {
      "name": "ASP.NET Core",
      "kind": "framework",
      "implements": [
        "architecture/compute/service/api-service"
      ]
    },
    "kubernetes": {
      "name": "Kubernetes",
      "kind": "platform",
      "implements": [
        "architecture/platform/orchestration/container-orchestrator"
      ]
    },
    "opentelemetry": {
      "name": "OpenTelemetry",
      "kind": "observability",
      "implements": [
        "concepts/observability/telemetry/tracing",
        "code/observability/tracing/trace-instrumentation"
      ]
    }
  }
