{
  "env": {
    "AI_AGILE_ROOT": "."
  },
  "permissions": {
    "allow": [
      "Edit(.claude/agents/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/run-agent-scope.sh"
          }
        ]
      }
    ]
  }
}
